datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ActiveMode {
  SEEKER
  RECRUITER
}

enum JobType {
  SHORT_TERM
  LONG_TERM
}

enum PayUnit {
  FIXED
  PER_HOUR
  PER_MONTH
}

enum JobStatus {
  OPEN
  FILLED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  JOB_ACCEPTED
  SEEKER_CANCELLED
  RECRUITER_CANCELLED
  BLOCKED
  REMINDER
  REPORT_RESOLVED
  NEW_MESSAGE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FRAUD
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum ActionLogType {
  BLOCK_USER
  UNBLOCK_USER
  REMOVE_JOB
  RESOLVE_REPORT
  LOGIN
}

model User {
  id                         String         @id @default(uuid())
  email                      String         @unique
  passwordHash               String
  name                       String
  phone                      String?
  avatarUrl                  String?
  activeMode                 ActiveMode     @default(SEEKER)
  isVerified                 Boolean        @default(false)
  verificationOtp            String?
  verificationOtpExpiresAt   DateTime?
  cancellationCount          Int            @default(0)
  isBlocked                  Boolean        @default(false)
  blockedUntil               DateTime?
  locationLat                Float?
  locationLng                Float?
  locationLabel              String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  postedJobs                 Job[]          @relation("UserPostedJobs")
  applications               Application[]  @relation("UserApplications")
  savedJobs                  SavedJob[]
  notifications              Notification[]
  reportsFiled               Report[]       @relation("UserReportsFiled")
  conversationsAsSeeker      Conversation[] @relation("SeekerConversations")
  conversationsAsRecruiter   Conversation[] @relation("RecruiterConversations")
  sentMessages               Message[]
  refreshTokens              RefreshToken[]

  @@index([locationLat, locationLng])
  @@index([email])
}

model Job {
  id            String         @id @default(uuid())
  posterId      String
  poster        User           @relation("UserPostedJobs", fields: [posterId], references: [id], onDelete: Cascade)
  type          JobType
  title         String
  description   String
  pay           Decimal        @db.Decimal(10, 2)
  payUnit       PayUnit
  openings      Int            @default(1)
  filledCount   Int            @default(0)
  isRemote      Boolean        @default(false)
  locationLat   Float          @default(0.0)
  locationLng   Float          @default(0.0)
  locationLabel String         @default("HIDDEN")
  startDate     String         // YYYY-MM-DD
  endDate       String?        // YYYY-MM-DD
  startTime     String?        // HH:mm
  endTime       String?        // HH:mm
  status        JobStatus      @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  applications  Application[]
  savedBy       SavedJob[]
  conversations Conversation[]

  @@index([locationLat, locationLng])
  @@index([status])
  @@index([posterId])
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerId    String
  seeker      User              @relation("UserApplications", fields: [seekerId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(ACCEPTED)
  acceptedAt  DateTime          @default(now())
  cancelledAt DateTime?

  @@unique([jobId, seekerId, status])
  @@index([jobId])
  @@index([seekerId])
}

model Conversation {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerId    String
  seeker      User      @relation("SeekerConversations", fields: [seekerId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   User      @relation("RecruiterConversations", fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@unique([jobId, seekerId])
  @@index([seekerId])
  @@index([recruiterId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  isRead       Boolean          @default(false)
  relatedJobId String?
  createdAt    DateTime         @default(now())

  @@index([userId])
}

model Report {
  id          String       @id @default(uuid())
  targetType  String       // "JOB" | "USER"
  targetId    String
  targetTitle String       @default("")
  reporterId  String
  reporter    User         @relation("UserReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason      ReportReason
  description String
  status      ReportStatus @default(PENDING)
  adminNote   String?
  resolvedBy  String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([reporterId])
  @@index([status])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
}

model ActionLog {
  id         String        @id @default(uuid())
  adminId    String
  adminName  String
  action     ActionLogType
  targetType String        // "USER" | "JOB" | "REPORT" | "SESSION"
  targetId   String?
  note       String?
  createdAt  DateTime      @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
